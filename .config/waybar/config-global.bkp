{
  "layer": "top",
  "spacing": 0,
  "width": 36,
  "fixed-center": false,

  "backlight": {
    "format": "{icon}",
    "format-icons": [
      "󱩎 ",
      "󱩎 ",
      "󱩏 ",
      "󱩐 ",
      "󱩑 ",
      "󱩒 ",
      "󱩓 ",
      "󱩔 ",
      "󱩕 ",
      "󱩖 ",
      "󰛨 "
    ],
    "tooltip": false
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-full": "󰁹",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip": true,
    "tooltip-format": "{timeTo}\nPower: {power} Watt"
  },

  "clock": {
    "timezone": "Europe/Bucharest",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><big>{calendar}</big></tt>",
    "format-alt": "{:%d/%m}",
    "interval": 60,
    "format": "{:%H:%M}",
    "max-length": 25
  },

  "cpu": {
    "interval": 10,
    "format": "󰍛{usage}",
    "states": {
      "value-0": 0,
      "value-1": 10,
      "value-2": 30,
      "value-3": 50,
      "value-4": 80,
      "value-5": 100
    },
    "tooltip": true,
    "on-click-right": "alacritty -e btop"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛊",
      "deactivated": "󰾫"
    },
    "tooltip": false
  },

  "memory": {
    "interval": 10,
    "format": "󰘚{percentage}",
    "states": {
      "value-0": 0,
      "value-1": 20,
      "value-2": 40,
      "value-3": 60,
      "value-4": 80,
      "value-5": 100
    },
    "tooltip": true,
    "tooltip-format": "RAM:\nUsed: {used} GiB\nAvailable: {avail} GiB\n\nSwap:\nUsed: {swapUsed} GiB\nAvailable: {swapAvail} GiB",
    "on-click-right": "alacritty -e btop"
  },

  "network": {
    "interface": "wlan0",
    "format-wifi": "{icon}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤫",
    "format-disabled": "󰤮",
    "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "alacritty -e iwctl",
    "on-click-right": "rfkill toggle wifi"
  },

  "custom/audio": {
    "format": "{text}",
    "return-type": "json",
    "exec": "~/.local/bin/waybar-audio",
    "interval": 1,
    "on-click": "alacritty --class pulsemixer -e pulsemixer",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip": true
  },

  "river/window": {
    "format": "{}",
    "max-length": 300,
    "rotate": 90,
    "tooltip": false
  },

"temperature": {
  "hwmon-path": "/sys/class/hwmon/hwmon4/temp3_input",
  "critical-threshold": 80,
  "format": "{icon}{temperatureC}",
  "format-icons": ["", "", "", "", ""],
  "states": {
    "value-0": 0,
    "value-1": 32,
    "value-2": 44,
    "value-3": 56,
    "value-4": 68,
    "value-5": 80
  },
  "interval": 10,
  "tooltip": false
},

  "tray": {
    "icon-size": 20,
    "show-passive-items": true,
    "smooth-scrolling-threshold": 1,
    "spacing": 3
  }
}
